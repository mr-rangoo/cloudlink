# Cloudlink environment template. Placeholder values only. Copy to .env and fill in.
# APP_ENV is the deployment environment (development | test | staging | production).
# Production refuses to start with mock adapters, demo seed, http APP_URL or placeholder secrets.
APP_ENV=development
APP_URL=http://localhost:3100
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES
LOG_LEVEL=info

# PostgreSQL. Docker Compose exposes 5432; the optional project-local cluster uses 5433.
DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink?schema=public
# Isolated databases for automated tests. Names MUST end in _test / _e2e (enforced).
TEST_DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink_test?schema=public
E2E_DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink_e2e?schema=public
DATABASE_POOL_MAX=10

# Redis for BullMQ dispatch. Optional in development: the worker falls back to PostgreSQL polling.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Generate with: openssl rand -base64 48   (AUTH_SECRET, >= 32 chars)
AUTH_SECRET=replace-with-a-long-random-development-secret
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
APP_ENCRYPTION_KEY=replace-with-a-valid-application-encryption-key
SESSION_TTL_HOURS=12

# Daraja — use sandbox credentials in development
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Messaging provider (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS_PROVIDER=africastalking (implemented, not yet verified with real credentials)
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=

# Object storage (optional). STORAGE_ADAPTER=local writes under STORAGE_LOCAL_DIR.
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Network integrations (see docs/NETWORK.md)
# api-ssl forces the TLS API (8729) for every router; api allows the plain API on private links.
MIKROTIK_CONNECTION_MODE=mock
# Comma-separated private CIDRs (VPN / LAN) that router management addresses must fall in. Required in production.
MIKROTIK_ALLOWED_NETWORKS=
ROUTEROS_TIMEOUT_MS=8000
# Reference values for NAS configuration; Cloudlink does not send RADIUS packets itself.
RADIUS_SERVER_ADDRESS=
RADIUS_SHARED_SECRET=
# FreeRADIUS SQL database (radcheck/radreply/radusergroup/radacct) for routers using RADIUS authentication.
RADIUS_DATABASE_URL=
RADIUS_DB_SCHEMA=public
# Shortens retry backoff outside production (end-to-end tests only). Leave empty.
OPERATION_BACKOFF_BASE_MS=

# Worker health endpoint for container probes (optional, binds 127.0.0.1)
WORKER_HEALTH_PORT=

# Adapters: mock | <real provider> | disabled. Mocks are rejected when APP_ENV=production.
PAYMENT_ADAPTER=mock
NETWORK_ADAPTER=mock
MESSAGING_ADAPTER=mock
ENABLE_DEMO_SEED=true
