# Cloudlink environment template. Placeholder values only. Copy to .env and fill in.
# APP_ENV is the deployment environment (development | test | staging | production).
# Production refuses to start with mock adapters, demo seed, http APP_URL or placeholder secrets.
APP_ENV=development
APP_URL=http://localhost:3100
APP_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES
LOG_LEVEL=info

# PostgreSQL. Docker Compose exposes 5432; the optional project-local cluster uses 5433.
DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink?schema=public
# Isolated databases for automated tests. Names MUST end in _test / _e2e (enforced).
TEST_DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink_test?schema=public
E2E_DATABASE_URL=postgresql://cloudlink:cloudlink_dev_password@localhost:5432/cloudlink_e2e?schema=public
DATABASE_POOL_MAX=10

# Redis for BullMQ dispatch. Optional in development: the worker falls back to PostgreSQL polling.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Generate with: openssl rand -base64 48   (AUTH_SECRET, >= 32 chars)
AUTH_SECRET=replace-with-a-long-random-development-secret
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
APP_ENCRYPTION_KEY=replace-with-a-valid-application-encryption-key
SESSION_TTL_HOURS=12

# M-Pesa Daraja (see docs/PAYMENTS.md). Normally each organization saves its own credentials under
# Integrations (stored encrypted). These variables are a single-tenant alternative, used only for the
# organization whose slug is MPESA_ENV_ORGANIZATION. Use sandbox credentials until you are ready.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV_ORGANIZATION=
# PAYBILL or TILL; for a till, MPESA_SHORTCODE is the store number and MPESA_TILL_NUMBER the till.
MPESA_SHORTCODE_TYPE=PAYBILL
MPESA_TILL_NUMBER=
# Public HTTPS base URL M-Pesa calls back (defaults to APP_URL).
MPESA_CALLBACK_URL=
# Optional comma-separated IPs/CIDRs allowed to call the M-Pesa webhooks (first X-Forwarded-For hop).
MPESA_CALLBACK_ALLOWED_IPS=
# Confirm every callback with an STK status query before recording money. Cannot be false in production.
MPESA_VERIFY_CALLBACKS=true

# Messaging provider (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Single-tenant fallback (organizations can save their own providers under Integrations):
# SMS_PROVIDER=africastalking | twilio (implemented, not yet verified with real credentials).
# For twilio: SMS_USERNAME = account SID, SMS_API_KEY = auth token, SMS_SENDER_ID = sender number or MG… service SID.
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=

# Object storage (optional). STORAGE_ADAPTER=local writes under STORAGE_LOCAL_DIR.
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Network integrations (see docs/NETWORK.md)
# api-ssl forces the TLS API (8729) for every router; api allows the plain API on private links.
MIKROTIK_CONNECTION_MODE=mock
# Comma-separated private CIDRs (VPN / LAN) that router management addresses must fall in. Required in production.
MIKROTIK_ALLOWED_NETWORKS=
ROUTEROS_TIMEOUT_MS=8000
# Addresses the Cloudlink worker connects to routers from (e.g. its WireGuard/VPN address), written into router
# setup scripts as the only allowed API sources. Empty = private ranges only (looser).
ROUTER_MANAGEMENT_SOURCES=
# RADIUS server for routers that use RADIUS: written into their setup scripts. Cloudlink does not send RADIUS packets itself.
RADIUS_SERVER_ADDRESS=
RADIUS_SHARED_SECRET=
# FreeRADIUS SQL database (radcheck/radreply/radusergroup/radacct) for routers using RADIUS authentication.
RADIUS_DATABASE_URL=
RADIUS_DB_SCHEMA=public
# Shortens retry backoff outside production (end-to-end tests only). Leave empty.
OPERATION_BACKOFF_BASE_MS=

# Worker health endpoint for container probes (optional, binds 127.0.0.1)
WORKER_HEALTH_PORT=

# Adapters: mock | <real provider> | disabled. Mocks are rejected when APP_ENV=production.
PAYMENT_ADAPTER=mock
NETWORK_ADAPTER=mock
MESSAGING_ADAPTER=mock

# Customer-portal AI assistant (Claude): anthropic | mock | disabled. Each organization must also switch it on
# under Settings -> AI assistant. The API key is used only by the server and is never sent to browsers.
ASSISTANT_ADAPTER=mock
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high (low suits short support chats)
ASSISTANT_EFFORT=low
# Test-only override of the Claude API address. Leave empty.
ASSISTANT_BASE_URL=
ENABLE_DEMO_SEED=true
# Self-service sign-up for new ISP workspaces at /signup (email confirmation required): open | closed
SIGNUP_MODE=open
