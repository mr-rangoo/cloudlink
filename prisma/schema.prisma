// Cloudlink database schema.
// Conventions:
// - Every tenant-owned model carries organizationId and is queried through tenant-scoped services.
// - Money uses Decimal(14,2) with an explicit currency column.
// - Timestamps are stored in UTC (timestamptz). Business schedules use Africa/Nairobi.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Organization & identity ─────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserKind {
  STAFF
  CUSTOMER
}

model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String             @unique
  currency  String             @default("KES") @db.Char(3)
  timezone  String             @default("Africa/Nairobi")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  branches     Branch[]
  memberships  Membership[]
  roles        Role[]
  auditLogs    AuditLog[]
  integrations IntegrationConfiguration[]
  sessions     Session[]
}

model Branch {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  address        String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  memberships  MembershipBranch[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  kind         UserKind   @default(STAFF)
  name         String
  email        String     @unique // stored normalised (lower-case, trimmed)
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @db.Timestamptz(6)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
}

// Access of one user to one organization. Roles and branch scope hang off the membership.
model Membership {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  status         RecordStatus @default(ACTIVE)
  // When true the member can access every branch; otherwise only the branches listed in MembershipBranch.
  allBranches    Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  roles        MembershipRole[]
  branches     MembershipBranch[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model MembershipBranch {
  membershipId String @db.Uuid
  branchId     String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@id([membershipId, branchId])
}

model Permission {
  key         String @id
  description String

  roles RolePermission[]
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  key            String // e.g. owner, accountant
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
}

model MembershipRole {
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
}

// Server-side session. The browser only holds a random token; the database stores its SHA-256 hash.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  activeBranchId String?   @db.Uuid
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Fixed-window rate limiter stored in PostgreSQL so it works without Redis and across instances.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(6)
  count       Int

  @@index([windowStart])
}

// ───────────────────────── Operations & audit ─────────────────────────

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actorType      String // user | system | customer | webhook
  action         String // e.g. auth.login, subscriber.create
  entityType     String?
  entityId       String?
  metadata       Json? // safe, redacted details
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId, createdAt])
  @@index([action, createdAt])
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model IdempotencyRecord {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String?           @db.Uuid
  scope          String // e.g. org:<id>:payments.manual
  key            String
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime          @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
}

enum BackgroundOperationStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

// Durable record for every background job. Redis/BullMQ only dispatches; this row is the source of truth.
model BackgroundOperation {
  id             String                    @id @default(uuid(7)) @db.Uuid
  organizationId String?                   @db.Uuid
  type           String
  dedupeKey      String?                   @unique
  status         BackgroundOperationStatus @default(PENDING)
  payload        Json
  attempts       Int                       @default(0)
  maxAttempts    Int                       @default(5)
  lastError      String? // safe, redacted error code/message
  correlationId  String?
  runAfter       DateTime                  @default(now()) @db.Timestamptz(6)
  startedAt      DateTime?                 @db.Timestamptz(6)
  finishedAt     DateTime?                 @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter])
  @@index([organizationId, type, createdAt])
}

model WorkerHeartbeat {
  workerId  String   @id
  hostname  String
  startedAt DateTime @db.Timestamptz(6)
  seenAt    DateTime @db.Timestamptz(6)
  queues    String[]
}

enum IntegrationStatus {
  NOT_CONFIGURED
  MOCK
  SANDBOX_TESTED
  PRODUCTION_VERIFIED
  ERROR
}

model IntegrationConfiguration {
  id              String            @id @default(uuid(7)) @db.Uuid
  organizationId  String            @db.Uuid
  provider        String // mpesa_daraja, mikrotik_routeros, radius, smtp, sms, s3
  status          IntegrationStatus @default(NOT_CONFIGURED)
  safeConfig      Json? // non-secret settings only
  encryptedSecret String? // AES-256-GCM envelope, never returned to clients
  lastCheckedAt   DateTime?         @db.Timestamptz(6)
  lastError       String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

// ───────────────────────── Sequences ─────────────────────────

// Per-organization counters (account numbers, invoice numbers, receipts).
model OrganizationCounter {
  organizationId String @db.Uuid
  key            String
  value          Int    @default(0)

  @@id([organizationId, key])
}

// ───────────────────────── Catalogue ─────────────────────────

enum ServiceType {
  PPPOE
  HOTSPOT
  STATIC_IP
  OTHER
}

enum BillingUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

/// What a plan grants, independent of the access technology (serviceType).
enum PackageKind {
  TIME // unlimited data for the duration
  DATA // a data bundle (dataQuotaMb) usable within the duration
  TRIAL // short trial, may be free; once per customer within trialCooldownDays
  DEVICE // TV / streaming device that cannot use a login page (access by MAC)
}

model Package {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  serviceType    ServiceType
  kind           PackageKind  @default(TIME)
  price          Decimal      @db.Decimal(14, 2)
  currency       String       @db.Char(3)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2) // percent, e.g. 16.00 for VAT
  billingUnit    BillingUnit  @default(MONTH)
  billingCount   Int          @default(1)
  downloadKbps   Int?
  uploadKbps     Int?
  dataQuotaMb    Int?
  deviceLimit    Int?
  networkProfile String? // PPP / hotspot profile name on the router (defaults to the package name)
  status         RecordStatus @default(ACTIVE)
  /// Shown to customers for self-service (captive portal, customer portal). ACTIVE + unlisted = "hidden": staff can still sell it.
  listed         Boolean      @default(true)
  /// Marketing label shown with the plan: POPULAR | OFFER.
  highlight      String?
  sortOrder      Int          @default(0)
  // MikroTik burst (all four rates and the time, or none)
  burstDownloadKbps          Int?
  burstUploadKbps            Int?
  burstThresholdDownloadKbps Int?
  burstThresholdUploadKbps   Int?
  burstTimeSeconds           Int?
  // Fair use policy: after fupThresholdMb in one period, throttle to the FUP rates or disconnect.
  fupEnabled      Boolean @default(false)
  fupThresholdMb  Int?
  fupAction       String? // THROTTLE | DISCONNECT
  fupDownloadKbps Int?
  fupUploadKbps   Int?
  // Time-of-day restriction in the organization timezone (minutes after local midnight; the window may cross midnight).
  scheduleEnabled     Boolean @default(false)
  scheduleStartMinute Int?
  scheduleEndMinute   Int?
  /// Days the window starts on: bit 0 = Monday … bit 6 = Sunday. Null = every day.
  scheduleDays        Int?
  /// TRIAL plans: the same phone or device can take the trial again only after this many days.
  trialCooldownDays   Int?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
  leads         Lead[]
  routers       PackageRouter[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

/// NAS restriction: when a plan has rows here it may only be used on these routers (none = every router).
model PackageRouter {
  packageId      String @db.Uuid
  routerId       String @db.Uuid
  organizationId String @db.Uuid

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  router  Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@id([packageId, routerId])
  @@index([routerId])
}

// ───────────────────────── Subscribers ─────────────────────────

enum SubscriberType {
  INDIVIDUAL
  BUSINESS
}

enum SubscriberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Subscriber {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @db.Uuid
  branchId        String?          @db.Uuid
  accountNumber   String
  type            SubscriberType   @default(INDIVIDUAL)
  displayName     String
  firstName       String?
  lastName        String?
  companyName     String?
  email           String?
  emailNormalized String?
  phone           String // E.164 digits without plus, e.g. 254712345678
  altPhone        String?
  idNumber        String? // national ID or KRA PIN
  status          SubscriberStatus @default(ACTIVE)
  notes           String?
  /// Priority customer: flagged in lists and filterable.
  vip             Boolean          @default(false)
  /// How the account was created: staff | hotspot (self-service purchase on the captive portal) | import | lead.
  source          String           @default("staff")
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  contacts      SubscriberContact[]
  addresses     SubscriberAddress[]
  activities    SubscriberActivity[]
  subscriptions Subscription[]
  lead          Lead?

  @@unique([organizationId, accountNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, phone])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, branchId])
}

model SubscriberContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  subscriberId   String   @db.Uuid
  name           String
  phone          String?
  email          String?
  relationship   String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
}

model SubscriberAddress {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  subscriberId   String   @db.Uuid
  label          String   @default("Installation")
  line1          String
  area           String?
  town           String?
  county         String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
}

model SubscriberActivity {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  subscriberId   String   @db.Uuid
  actorUserId    String?  @db.Uuid
  type           String // created, updated, note, subscription.*, lead.converted, import
  message        String
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, createdAt])
  @@index([organizationId, createdAt])
}

// ───────────────────────── Subscriptions ─────────────────────────

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @db.Uuid
  branchId           String?            @db.Uuid
  subscriberId       String             @db.Uuid
  packageId          String             @db.Uuid
  status             SubscriptionStatus @default(PENDING)
  // Commercial snapshot taken when the subscription is created or the package changes.
  packageName        String
  serviceType        ServiceType
  price              Decimal            @db.Decimal(14, 2)
  currency           String             @db.Char(3)
  taxRate            Decimal            @db.Decimal(5, 2)
  billingUnit        BillingUnit
  billingCount       Int
  // Lifecycle. Period boundaries are computed from billingAnchorAt + periodIndex to avoid month-end drift.
  billingAnchorAt    DateTime?          @db.Timestamptz(6)
  /// -1 after a compensation: the current period was extended and the next regular period starts at billingAnchorAt.
  periodIndex        Int                @default(0)
  currentPeriodStart DateTime?          @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @db.Timestamptz(6)
  nextBillingAt      DateTime?          @db.Timestamptz(6) // when the next invoice will be generated
  invoicedThrough    DateTime?          @db.Timestamptz(6) // end of the latest period that has an invoice
  // Network provisioning (independent of billing status)
  networkRouterId    String?            @db.Uuid
  networkUsername    String?
  networkPasswordEnc String? // AES-GCM envelope; plaintext only exists in memory while provisioning
  networkStatus      String             @default("NOT_PROVISIONED") // NOT_PROVISIONED | PENDING | ACTIVE | DISABLED | SIMULATED | ERROR
  networkUpdatedAt   DateTime?          @db.Timestamptz(6)
  /// Hotspot: the device the plan was bought on; device (TV) plans: the device given access by MAC.
  networkMac         String?
  graceDays          Int                @default(0)
  autoRenew          Boolean            @default(true)
  activatedAt        DateTime?          @db.Timestamptz(6)
  suspendedAt        DateTime?          @db.Timestamptz(6)
  cancelledAt        DateTime?          @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  subscriber Subscriber          @relation(fields: [subscriberId], references: [id])
  package    Package             @relation(fields: [packageId], references: [id])
  events     SubscriptionEvent[]

  @@unique([organizationId, networkUsername])
  @@index([organizationId, status, nextBillingAt])
  @@index([organizationId, status, currentPeriodEnd])
  @@index([subscriberId])
}

model SubscriptionEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  subscriptionId String              @db.Uuid
  type           String // created, activated, renewed, suspended, reactivated, cancelled, expired, package_changed
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  actorUserId    String?             @db.Uuid
  actorType      String
  metadata       Json?
  // Makes renewals and other retried actions idempotent (e.g. renew:payment:<id>).
  idempotencyKey String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, idempotencyKey])
  @@index([organizationId, createdAt])
}

// ───────────────────────── CRM ─────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_SURVEY
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WALK_IN
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  PHONE_CALL
  FIELD_AGENT
  OTHER
}

model Lead {
  id                    String     @id @default(uuid(7)) @db.Uuid
  organizationId        String     @db.Uuid
  branchId              String?    @db.Uuid
  name                  String
  phone                 String
  email                 String?
  emailNormalized       String?
  source                LeadSource @default(OTHER)
  stage                 LeadStage  @default(NEW)
  ownerId               String?    @db.Uuid
  interestedPackageId   String?    @db.Uuid
  location              String?
  notes                 String?
  lostReason            String?
  convertedSubscriberId String?    @unique @db.Uuid
  convertedAt           DateTime?  @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(6)

  interestedPackage   Package?       @relation(fields: [interestedPackageId], references: [id])
  convertedSubscriber Subscriber?    @relation(fields: [convertedSubscriberId], references: [id])
  activities          LeadActivity[]

  @@index([organizationId, stage, createdAt])
  @@index([organizationId, phone])
  @@index([organizationId, ownerId])
}

model LeadActivity {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  actorUserId    String?  @db.Uuid
  type           String // created, note, call, stage_changed, assigned, updated, converted
  message        String
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ───────────────────────── Imports ─────────────────────────

enum ImportJobStatus {
  PREVIEWED
  COMMITTED
  FAILED
}

model ImportJob {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  type           String // subscribers
  status         ImportJobStatus @default(PREVIEWED)
  fileName       String
  totalRows      Int
  validRows      Int
  errorRows      Int
  errors         Json // [{ row, field, message }]
  normalizedRows Json? // validated rows awaiting commit (cleared after commit)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  committedAt    DateTime?       @db.Timestamptz(6)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Billing settings ─────────────────────────

model BillingSettings {
  organizationId      String   @id @db.Uuid
  invoicePrefix       String   @default("INV")
  receiptPrefix       String   @default("RCT")
  creditNotePrefix    String   @default("CRN")
  invoiceLeadDays     Int      @default(3) // generate the next invoice this many days before the period ends
  paymentTermsDays    Int      @default(0) // due date = period start (or issue date) + terms
  invoiceOnActivation Boolean  @default(true)
  /// Send "your service ends soon" this many days before the end of plans of a week or longer (0 = off).
  expiryReminderDays  Int      @default(3)
  taxLabel            String   @default("VAT")
  taxPin              String?
  legalName           String?
  address             String?
  phone               String?
  email               String?
  invoiceFooter       String?
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
}

// ───────────────────────── Invoices ─────────────────────────

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id                 String        @id @default(uuid(7)) @db.Uuid
  organizationId     String        @db.Uuid
  branchId           String?       @db.Uuid
  subscriberId       String        @db.Uuid
  subscriptionId     String?       @db.Uuid
  invoiceNumber      String? // assigned on issue (gapless per organization)
  status             InvoiceStatus @default(DRAFT)
  currency           String        @db.Char(3)
  subtotal           Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @default(0) @db.Decimal(14, 2)
  // Cached settlement figures, maintained transactionally and verified by reconciliation checks.
  amountPaid         Decimal       @default(0) @db.Decimal(14, 2)
  amountCredited     Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(14, 2)
  issuedAt           DateTime?     @db.Timestamptz(6)
  dueAt              DateTime?     @db.Timestamptz(6)
  paidAt             DateTime?     @db.Timestamptz(6)
  voidedAt           DateTime?     @db.Timestamptz(6)
  voidReason         String?
  billingPeriodStart DateTime?     @db.Timestamptz(6)
  billingPeriodEnd   DateTime?     @db.Timestamptz(6)
  // Unique generation key, e.g. "sub:<subscriptionId>:<periodStartISO>", making recurring billing idempotent.
  generationKey      String?
  source             String        @default("manual") // manual | recurring | activation
  notes              String?
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, generationKey])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, subscriberId, createdAt])
  @@index([subscriptionId])
}

// Immutable once the invoice is issued (enforced by a database trigger).
model InvoiceLine {
  id           String    @id @default(uuid(7)) @db.Uuid
  invoiceId    String    @db.Uuid
  position     Int
  description  String
  quantity     Decimal   @db.Decimal(12, 3)
  unitPrice    Decimal   @db.Decimal(14, 2)
  discount     Decimal   @default(0) @db.Decimal(14, 2)
  taxRate      Decimal   @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal   @db.Decimal(14, 2) // quantity × unitPrice, rounded
  taxAmount    Decimal   @db.Decimal(14, 2)
  lineTotal    Decimal   @db.Decimal(14, 2) // subtotal − discount + tax
  packageId    String?   @db.Uuid
  periodStart  DateTime? @db.Timestamptz(6)
  periodEnd    DateTime? @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
}

model CreditNote {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @db.Uuid
  invoiceId        String   @db.Uuid
  subscriberId     String   @db.Uuid
  creditNoteNumber String
  reason           String
  currency         String   @db.Char(3)
  subtotal         Decimal  @db.Decimal(14, 2)
  taxTotal         Decimal  @db.Decimal(14, 2)
  total            Decimal  @db.Decimal(14, 2)
  appliedToInvoice Decimal  @db.Decimal(14, 2) // part that reduced the invoice balance
  toCustomerCredit Decimal  @db.Decimal(14, 2) // part credited to the customer (invoice already settled)
  createdById      String?  @db.Uuid
  issuedAt         DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]

  @@unique([organizationId, creditNoteNumber])
  @@index([invoiceId])
}

model CreditNoteLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  creditNoteId String  @db.Uuid
  description  String
  amount       Decimal @db.Decimal(14, 2) // net of tax
  taxAmount    Decimal @db.Decimal(14, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Payments ─────────────────────────

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MPESA
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REVERSED
  UNKNOWN
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  organizationId        String        @db.Uuid
  branchId              String?       @db.Uuid
  subscriberId          String?       @db.Uuid // null = unmatched (awaiting reconciliation)
  method                PaymentMethod
  provider              String        @default("manual") // manual | mpesa_daraja | ...
  /// How the money arrived: manual (staff entry) | stk (M-Pesa prompt for an account) | hotspot (captive-portal purchase) | c2b (paybill/till).
  source                String        @default("manual")
  providerTransactionId String? // e.g. M-Pesa receipt or bank reference; unique per provider
  receiptNumber         String? // assigned when confirmed
  amount                Decimal       @db.Decimal(14, 2)
  currency              String        @db.Char(3)
  status                PaymentStatus @default(PENDING)
  receivedAt            DateTime?     @db.Timestamptz(6)
  payerName             String?
  payerPhone            String?
  accountReference      String? // what the payer typed (e.g. paybill account number)
  notes                 String?
  // Cached; verified by reconciliation. unallocated = amount − active allocations − refunds.
  allocatedAmount       Decimal       @default(0) @db.Decimal(14, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(14, 2)
  recordedById          String?       @db.Uuid
  reversedAt            DateTime?     @db.Timestamptz(6)
  reversalReason        String?
  metadata              Json?
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([organizationId, provider, providerTransactionId])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, subscriberId])
  @@index([organizationId, source, receivedAt])
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

model PaymentAllocation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  paymentId      String           @db.Uuid
  invoiceId      String           @db.Uuid
  amount         Decimal          @db.Decimal(14, 2)
  status         AllocationStatus @default(ACTIVE)
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  reversedAt     DateTime?        @db.Timestamptz(6)
  reversalReason String?

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
}

model Refund {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  paymentId      String        @db.Uuid
  subscriberId   String?       @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @db.Char(3)
  method         PaymentMethod
  reference      String?
  reason         String
  createdById    String?       @db.Uuid
  refundedAt     DateTime      @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([organizationId, refundedAt])
}

// ───────────────────────── Ledger (double entry) ─────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model LedgerAccount {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  code           String
  name           String
  type           LedgerAccountType
  isSystem       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  entries LedgerEntry[]

  @@unique([organizationId, code])
}

model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  type           String // invoice.issued, invoice.voided, payment.received, allocation, allocation.reversed, credit_note, refund, payment.reversed, expense, withdrawal
  sourceType     String
  sourceId       String   @db.Uuid
  description    String
  currency       String   @db.Char(3)
  occurredAt     DateTime @db.Timestamptz(6)
  actorUserId    String?  @db.Uuid
  actorType      String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  entries LedgerEntry[]

  @@index([organizationId, occurredAt])
  @@index([organizationId, sourceType, sourceId])
}

// Balanced per transaction (sum of debits = sum of credits), enforced by a deferred constraint trigger.
model LedgerEntry {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  transactionId  String  @db.Uuid
  accountId      String  @db.Uuid
  subscriberId   String? @db.Uuid
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId])
  @@index([organizationId, subscriberId])
  @@index([transactionId])
}

// ───────────────────────── Expenses and withdrawals ─────────────────────────

model ExpenseCategory {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  status         RecordStatus @default(ACTIVE)

  @@unique([organizationId, name])
}

model Expense {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  categoryId     String        @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @db.Char(3)
  method         PaymentMethod
  paidAt         DateTime      @db.Timestamptz(6)
  payee          String?
  reference      String?
  description    String
  status         String        @default("RECORDED") // RECORDED | REVERSED
  reversedAt     DateTime?     @db.Timestamptz(6)
  reversalReason String?
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  @@index([organizationId, paidAt])
}

model Withdrawal {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @db.Char(3)
  fromMethod     PaymentMethod // which cash/bank/M-Pesa account the money left
  kind           String // OWNER_DRAWING | BANK_DEPOSIT
  occurredAt     DateTime      @db.Timestamptz(6)
  reference      String?
  description    String
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
}

model ReconciliationRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  paymentId      String?  @db.Uuid
  action         String // matched, unmatched, flagged, balance_check
  outcome        String // ok, mismatch, assigned, ...
  details        Json?
  actorUserId    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([paymentId])
}

// ───────────────────────── Customer portal ─────────────────────────

enum CustomerAccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

// Portal login for one subscriber. Separate from staff users: customers sign in with phone or account number.
model CustomerAccount {
  id              String                @id @default(uuid(7)) @db.Uuid
  organizationId  String                @db.Uuid
  subscriberId    String                @unique @db.Uuid
  loginPhone      String // normalised E.164 digits
  passwordHash    String?
  status          CustomerAccountStatus @default(INVITED)
  inviteTokenHash String?               @unique
  inviteExpiresAt DateTime?             @db.Timestamptz(6)
  failedLogins    Int                   @default(0)
  lockedUntil     DateTime?             @db.Timestamptz(6)
  lastLoginAt     DateTime?             @db.Timestamptz(6)
  activatedAt     DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)

  sessions CustomerSession[]

  @@unique([organizationId, loginPhone])
}

model CustomerSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  tokenHash         String    @unique
  customerAccountId String    @db.Uuid
  organizationId    String    @db.Uuid
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, revokedAt])
}

// ───────────────────────── Support ─────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  CONNECTIVITY
  BILLING
  INSTALLATION
  EQUIPMENT
  ACCOUNT
  OTHER
}

model SupportTicket {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @db.Uuid
  branchId            String?        @db.Uuid
  subscriberId        String?        @db.Uuid
  ticketNumber        String
  subject             String
  description         String
  category            TicketCategory @default(OTHER)
  priority            TicketPriority @default(NORMAL)
  status              TicketStatus   @default(OPEN)
  channel             String         @default("staff") // staff | portal | phone | walk_in | email
  assigneeId          String?        @db.Uuid
  createdByUserId     String?        @db.Uuid
  createdByCustomerId String?        @db.Uuid
  firstResponseAt     DateTime?      @db.Timestamptz(6)
  resolvedAt          DateTime?      @db.Timestamptz(6)
  resolution          String?
  closedAt            DateTime?      @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  comments    TicketComment[]
  events      TicketEvent[]
  attachments TicketAttachment[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status, priority])
  @@index([organizationId, subscriberId])
  @@index([organizationId, assigneeId])
}

model TicketComment {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @db.Uuid
  ticketId         String   @db.Uuid
  authorUserId     String?  @db.Uuid
  authorCustomerId String?  @db.Uuid
  body             String
  internal         Boolean  @default(false) // staff-only note, never shown to the customer
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  ticketId       String   @db.Uuid
  actorUserId    String?  @db.Uuid
  actorType      String // user | customer | system
  type           String // created, status_changed, assigned, priority_changed, resolved, reopened
  fromValue      String?
  toValue        String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @db.Uuid
  ticketId             String   @db.Uuid
  commentId            String?  @db.Uuid
  fileName             String
  contentType          String
  sizeBytes            Int
  storageKey           String   @unique
  sha256               String
  uploadedByUserId     String?  @db.Uuid
  uploadedByCustomerId String?  @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model NotificationTemplate {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  key            String // invoice.issued, payment.received, ticket.reply, portal.invite, subscription.expiring
  channel        NotificationChannel
  subject        String?
  body           String
  active         Boolean             @default(true)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, key, channel])
}

model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @db.Uuid
  subscriberId      String?             @db.Uuid
  channel           NotificationChannel
  templateKey       String
  category          String // billing | service | support | account
  recipient         String
  subject           String?
  body              String
  status            NotificationStatus  @default(QUEUED)
  provider          String?
  providerMessageId String?
  simulated         Boolean             @default(false) // true when sent through a mock adapter
  attempts          Int                 @default(0)
  lastError         String?
  dedupeKey         String              @unique
  /// Non-secret references the worker needs at send time (e.g. the voucher whose code is filled in then).
  metadata          Json?
  /// Set for messages sent by a campaign.
  campaignId        String?             @db.Uuid
  sentAt            DateTime?           @db.Timestamptz(6)
  deliveredAt       DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([subscriberId])
  @@index([campaignId, status])
}

/// A bulk message to a filtered audience. Each recipient's message is a Notification with campaignId set.
model MessageCampaign {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  channel        NotificationChannel
  /// service = notices about the customer's service (service preference); marketing = offers (only customers who agreed).
  kind           String
  subject        String?
  body           String
  /// Subscriber filters (see the campaigns service); stored as chosen so the audience can be shown later.
  audience       Json
  status         String              @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  scheduledAt    DateTime?           @db.Timestamptz(6)
  startedAt      DateTime?           @db.Timestamptz(6)
  completedAt    DateTime?           @db.Timestamptz(6)
  /// Subscribers matched, messages queued, and matched subscribers skipped (opted out or no phone/email).
  recipients     Int                 @default(0)
  queued         Int                 @default(0)
  skipped        Int                 @default(0)
  createdById    String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@index([organizationId, createdAt])
}

/// Who is told when something needs an operator, and about what.
model OperatorAlertSettings {
  organizationId String   @id @db.Uuid
  /// [{ channel: "SMS" | "EMAIL", to: string, label?: string }]
  recipients     Json     @default("[]")
  /// router_offline | operation_failed | payment_unmatched | daily_digest
  events         Json     @default("[]")
  /// Local hour (0–23) at which the daily digest is sent.
  digestHour     Int      @default(7)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

model NotificationPreference {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  subscriberId   String              @db.Uuid
  channel        NotificationChannel
  category       String // billing | service | support | marketing (account messages are always sent; marketing is off unless agreed)
  enabled        Boolean             @default(true)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([subscriberId, channel, category])
}

// ───────────────────────── Administration ─────────────────────────

// Single-use staff setup / password-reset link. Only the token hash is stored.
model StaffInvite {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  purpose        String // setup | reset
  tokenHash      String    @unique
  expiresAt      DateTime  @db.Timestamptz(6)
  usedAt         DateTime? @db.Timestamptz(6)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

model ExportJob {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  type           String // subscribers | invoices | payments | receivables_aging | revenue | audit_logs
  params         Json
  status         ExportStatus @default(QUEUED)
  fileName       String?
  storageKey     String?
  rowCount       Int?
  error          String?
  requestedById  String       @db.Uuid
  expiresAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)
  lastDownloadAt DateTime?    @db.Timestamptz(6)
  downloadCount  Int          @default(0)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Inventory ─────────────────────────

enum InventoryStatus {
  IN_STOCK
  ASSIGNED
  FAULTY
  RETIRED
}

model InventoryItem {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String?         @db.Uuid
  category       String // router | onu | cpe | antenna | switch | other
  model          String
  serialNumber   String
  macAddress     String?
  status         InventoryStatus @default(IN_STOCK)
  subscriberId   String?         @db.Uuid
  purchaseCost   Decimal?        @db.Decimal(14, 2)
  purchasedAt    DateTime?       @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  movements InventoryMovement[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId, status])
  @@index([subscriberId])
}

model InventoryMovement {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  itemId         String           @db.Uuid
  action         String // received | assigned | returned | marked_faulty | repaired | retired | updated
  fromStatus     InventoryStatus?
  toStatus       InventoryStatus?
  subscriberId   String?          @db.Uuid
  actorUserId    String?          @db.Uuid
  note           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// ───────────────────────── Hotspot vouchers ─────────────────────────

// A voucher reseller (shop, kiosk, or the office itself). Owes the face value of redeemed vouchers, less commission.
model Agent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  name           String
  phone          String
  commissionRate Decimal      @default(0) @db.Decimal(5, 2) // percent of face value
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, phone])
}

enum VoucherStatus {
  UNUSED
  REDEEMED
  EXPIRED
  VOID
}

model VoucherBatch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  branchId       String?     @db.Uuid
  batchNumber    String
  packageId      String      @db.Uuid
  packageName    String
  durationUnit   BillingUnit
  durationCount  Int
  downloadKbps   Int?
  uploadKbps     Int?
  netPrice       Decimal     @db.Decimal(14, 2) // revenue per voucher, excl. tax
  taxRate        Decimal     @db.Decimal(5, 2)
  faceValue      Decimal     @db.Decimal(14, 2) // price paid by the customer, incl. tax
  currency       String      @db.Char(3)
  quantity       Int
  agentId        String?     @db.Uuid
  routerId       String?     @db.Uuid // hotspot router; defaults to the organization's hotspot router
  expiresAt      DateTime?   @db.Timestamptz(6) // last day the vouchers can be redeemed
  status         String      @default("ACTIVE") // ACTIVE | VOID
  notes          String?
  exportCount    Int         @default(0)
  createdById    String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  vouchers Voucher[]

  @@unique([organizationId, batchNumber])
  @@index([organizationId, createdAt])
}

model Voucher {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  batchId        String        @db.Uuid
  codeHash       String // keyed HMAC of the normalised code (lookup without storing plaintext)
  codeEncrypted  String // AES-256-GCM envelope, decrypted only for audited exports
  codeHint       String // last 3 characters, for support conversations
  status         VoucherStatus @default(UNUSED)
  redeemedAt     DateTime?     @db.Timestamptz(6)
  voidedAt       DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  batch      VoucherBatch       @relation(fields: [batchId], references: [id])
  redemption VoucherRedemption?

  @@unique([organizationId, codeHash])
  @@index([batchId, status])
}

model VoucherRedemption {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @db.Uuid
  voucherId        String    @unique @db.Uuid // single use, enforced by the database
  batchId          String    @db.Uuid
  agentId          String?   @db.Uuid
  channel          String // captive_portal | staff
  clientMac        String?
  clientIp         String?
  redeemedByUserId String?   @db.Uuid
  faceValue        Decimal   @db.Decimal(14, 2)
  accessEndsAt     DateTime  @db.Timestamptz(6)
  activationStatus String    @default("PENDING") // PENDING | ACTIVE | SIMULATED | FAILED
  activationDetail String?
  activatedAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@index([organizationId, createdAt])
  @@index([agentId])
}

model AgentCommission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  agentId        String   @db.Uuid
  redemptionId   String   @unique @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId])
}

model AgentRemittance {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  agentId        String        @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  receivedAt     DateTime      @db.Timestamptz(6)
  recordedById   String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  @@index([agentId])
}

// ───────────────────────── Network ─────────────────────────

enum RouterStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

enum PppoeAuthMode {
  LOCAL // PPPoE secrets live on the router (RouterOS API)
  RADIUS // the router authenticates PPPoE against RADIUS
}

model Router {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @db.Uuid
  branchId        String?       @db.Uuid
  name            String
  host            String // private address / VPN address only (allowlisted)
  apiPort         Int           @default(8728)
  useTls          Boolean       @default(false)
  pppoeAuth       PppoeAuthMode @default(LOCAL)
  hotspotEnabled  Boolean       @default(false)
  pppoeEnabled    Boolean       @default(true)
  /// Host name of the hotspot login page (e.g. "wifi.login"); the captive portal only posts logins to this host or a private address.
  hotspotDnsName  String?
  /// Interface whose traffic is charted (e.g. "ether1"); empty = the first running Ethernet port.
  uplinkInterface String?
  /// Planned work: offline alerts are not raised and the router page says so.
  maintenanceMode Boolean       @default(false)
  maintenanceNote String?
  status          RouterStatus  @default(UNKNOWN)
  identity        String?
  routerOsVersion String?
  boardName       String?
  lastSeenAt      DateTime?     @db.Timestamptz(6)
  lastCheckedAt   DateTime?     @db.Timestamptz(6)
  lastError       String?
  notes           String?
  archivedAt      DateTime?     @db.Timestamptz(6)
  // One-time setup command (see services/router-setup.ts): only the token hash is stored.
  setupTokenHash  String?       @unique
  setupExpiresAt  DateTime?     @db.Timestamptz(6)
  onboardedAt     DateTime?     @db.Timestamptz(6)
  onboardedFromIp String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  credential RouterCredential?
  packages   PackageRouter[]
  samples    RouterMetricSample[]
  snapshots  RouterSnapshot[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

// Encrypted API credentials (AES-256-GCM, AAD bound to the router id). Never returned to clients or logged.
model RouterCredential {
  routerId        String   @id @db.Uuid
  encryptedSecret String
  updatedById     String?  @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)
}

enum NetworkOperationStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  SIMULATED
  FAILED
  CANCELLED
}

model NetworkOperation {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  organizationId        String                 @db.Uuid
  routerId              String?                @db.Uuid
  subscriberId          String?                @db.Uuid
  subscriptionId        String?                @db.Uuid
  redemptionId          String?                @db.Uuid
  type                  String // allowlisted: see src/server/services/network.ts
  params                Json // non-secret parameters only (passwords are read from encrypted storage at execution time)
  status                NetworkOperationStatus @default(QUEUED)
  verification          String                 @default("PENDING") // VERIFIED | NOT_SUPPORTED | UNVERIFIED | PENDING
  idempotencyKey        String
  requestedById         String?                @db.Uuid
  requestedBy           String // user | system:<actor>
  resultDetail          String?
  attempts              Int                    @default(0)
  maxAttempts           Int                    @default(5)
  backgroundOperationId String?                @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  startedAt             DateTime?              @db.Timestamptz(6)
  completedAt           DateTime?              @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)

  attemptsLog NetworkOperationAttempt[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([routerId, createdAt])
  @@index([subscriptionId])
}

model NetworkOperationAttempt {
  id            String   @id @default(uuid(7)) @db.Uuid
  operationId   String   @db.Uuid
  attemptNumber Int
  outcome       String // SUCCESS | RETRYABLE_ERROR | PERMANENT_ERROR | SIMULATED
  errorCode     String?
  detail        String?
  durationMs    Int
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  operation NetworkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
}

model NetworkSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  routerId       String    @db.Uuid
  subscriberId   String?   @db.Uuid
  kind           String // PPPOE | HOTSPOT
  username       String
  externalId     String // router .id or RADIUS acct session id
  address        String?
  macAddress     String?
  uptimeSeconds  Int?
  bytesIn        BigInt?
  bytesOut       BigInt?
  source         String // router_api | radius_accounting | mock
  startedAt      DateTime? @db.Timestamptz(6)
  lastSeenAt     DateTime  @db.Timestamptz(6)
  endedAt        DateTime? @db.Timestamptz(6)

  @@unique([routerId, kind, externalId])
  @@index([organizationId, endedAt])
  @@index([subscriberId])
}

/// One health check: reachability and the router's resources at that moment (kept 35 days).
model RouterMetricSample {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  routerId       String   @db.Uuid
  takenAt        DateTime @db.Timestamptz(6)
  reachable      Boolean
  /// Mock adapter: values are simulated, not read from a router.
  simulated      Boolean  @default(false)
  /// Time to connect, log in and read the router's resources over the API (not ICMP ping).
  responseMs     Int?
  cpuLoad        Int?
  memoryUsedPct  Int?
  diskUsedPct    Int?
  temperatureC   Decimal? @db.Decimal(5, 1)
  uptimeSeconds  Int?
  /// Uplink traffic at that moment, bits per second (rx = into the router, tx = out of it).
  rxBps          BigInt?
  txBps          BigInt?
  /// Sessions open on the router at that moment (from the latest session sync).
  sessions       Int?

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([routerId, takenAt])
  @@index([organizationId, takenAt])
}

/// Read-only results fetched from a router on request: recent log lines, diagnosis checks.
model RouterSnapshot {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  routerId       String   @db.Uuid
  kind           String // logs | diagnosis
  data           Json
  simulated      Boolean  @default(false)
  operationId    String?  @db.Uuid
  takenAt        DateTime @default(now()) @db.Timestamptz(6)

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([routerId, kind, takenAt])
}

model RouterAlert {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  routerId       String?   @db.Uuid
  operationId    String?   @db.Uuid
  type           String // ROUTER_OFFLINE | OPERATION_FAILED | OPERATION_STUCK
  severity       String // warning | critical
  message        String
  status         String    @default("OPEN") // OPEN | RESOLVED
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime? @db.Timestamptz(6)

  @@index([organizationId, status])
  @@index([routerId, type, status])
}

// ───────────────────────── Payment gateways (M-Pesa Daraja) ─────────────────────────

enum PaymentAttemptStatus {
  PENDING // created; the provider has not accepted the request yet
  SUBMITTED // provider accepted the request; waiting for the customer and the callback
  CONFIRMED // a validated, verified callback confirmed the money; a Payment exists
  FAILED // provider reported a failure (insufficient funds, wrong PIN, rejected request …)
  CANCELLED // the customer cancelled the prompt
  EXPIRED // the customer did not respond in time
  UNKNOWN // outcome could not be determined; needs reconciliation
}

// One request for money (e.g. an STK Push). Money is recorded only as a Payment after confirmation.
model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @db.Uuid
  subscriberId      String?              @db.Uuid
  invoiceId         String?              @db.Uuid
  provider          String // mpesa_daraja | mock
  channel           String // staff | portal
  amount            Decimal              @db.Decimal(14, 2)
  currency          String               @db.Char(3)
  phone             String // MSISDN, 2547XXXXXXXX
  accountReference  String
  status            PaymentAttemptStatus @default(PENDING)
  idempotencyKey    String
  callbackTokenHash String               @unique // SHA-256 of the secret callback URL token
  merchantRequestId String?
  checkoutRequestId String?
  resultCode        String?
  resultDesc        String?
  providerReceipt   String?
  paymentId         String?              @unique @db.Uuid
  requestedById     String?              @db.Uuid
  requestedBy       String // user | customer | system
  detail            String? // latest human-readable explanation
  /// account = pay towards the account / an invoice; hotspot_purchase = buy a plan on the captive portal.
  purpose           String               @default("account")
  packageId         String?              @db.Uuid
  routerId          String?              @db.Uuid
  clientMac         String?
  clientIp          String?
  /// SHA-256 of the token the captive portal holds to follow this purchase (and receive login details).
  portalTokenHash   String?              @unique
  subscriptionId    String?              @db.Uuid
  /// When network access for the purchase was confirmed (activation time = activatedAt − completedAt).
  activatedAt       DateTime?            @db.Timestamptz(6)
  submittedAt       DateTime?            @db.Timestamptz(6)
  completedAt       DateTime?            @db.Timestamptz(6)
  lastQueriedAt     DateTime?            @db.Timestamptz(6)
  queryCount        Int                  @default(0)
  metadata          Json?
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, idempotencyKey])
  @@unique([provider, checkoutRequestId])
  @@index([organizationId, status, createdAt])
  @@index([subscriberId, status])
  @@index([subscriptionId])
}

enum WebhookEventStatus {
  RECEIVED // persisted; processing pending or waiting for verification
  PROCESSED
  REJECTED // failed validation (structure, context, amount or provider verification)
  FAILED // processing error; safe to process again
}

// Durable, deduplicated record of every accepted provider callback (payload minimised and redacted).
model WebhookEvent {
  id                   String             @id @default(uuid(7)) @db.Uuid
  organizationId       String?            @db.Uuid
  provider             String // mpesa_daraja | mock
  kind                 String // stk_callback | c2b_confirmation
  eventKey             String // CheckoutRequestID or TransID
  fingerprint          String // SHA-256 of the raw body
  status               WebhookEventStatus @default(RECEIVED)
  payload              Json
  attemptId            String?            @db.Uuid
  paymentId            String?            @db.Uuid
  error                String?
  sourceIp             String?
  duplicateCount       Int                @default(0)
  conflictingDuplicate Boolean            @default(false) // a repeat arrived with a different body
  receivedAt           DateTime           @default(now()) @db.Timestamptz(6)
  processedAt          DateTime?          @db.Timestamptz(6)

  @@unique([provider, kind, eventKey])
  @@index([organizationId, receivedAt])
  @@index([status, receivedAt])
}

// ───────────────────────── Branding and customer payment methods ─────────────────────────

// Look and feel chosen by the organization: theme preset, optional brand colour, default light/dark mode, logo.
model OrganizationBranding {
  organizationId  String    @id @db.Uuid
  themePreset     String    @default("midnight")
  customAccent    String? // #rrggbb, contrast-checked on save
  defaultMode     String    @default("light") // light | dark | system
  logoKey         String? // storage key; image sniffed as PNG/JPEG/WebP on upload
  logoContentType String?
  logoUpdatedAt   DateTime? @db.Timestamptz(6)
  portalWelcome   String?
  supportHours    String?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
}

/// Captive portal look and content (one row per organization; defaults apply when absent).
model HotspotSettings {
  organizationId String   @id @db.Uuid
  /// Portal template id (see src/lib/portal-templates.ts).
  template       String   @default("harbor")
  /// Line under the organization name; empty = the portal welcome text from Branding, or a default.
  headline       String?
  /// "How to buy" steps shown by templates that have room for them, one per line.
  instructions   String?
  /// E.164 digits; empty = the billing phone from General settings.
  supportPhone   String?
  whatsappPhone  String?
  showVouchers   Boolean  @default(true)
  showReconnect  Boolean  @default(true)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

// How customers can pay, shown in the portal, on invoices and on the hotspot page.
model CustomerPaymentMethod {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  kind           String // MPESA_PAYBILL | MPESA_TILL | BANK | CASH | OTHER
  label          String
  details        Json // validated per kind; no secrets
  instructions   String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, active, sortOrder])
}

// AI support assistant for the customer portal (off until an administrator enables it).
model AssistantSettings {
  organizationId String   @id @db.Uuid
  enabled        Boolean  @default(false)
  name           String   @default("Support assistant")
  instructions   String? // extra guidance from the organization, appended to the system prompt
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

// One customer chat. Messages are append-only and replayed to the model exactly as stored.
model AssistantConversation {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @db.Uuid
  branchId          String?  @db.Uuid // the customer's branch when the chat started (staff branch scoping)
  subscriberId      String   @db.Uuid
  customerAccountId String   @db.Uuid
  status            String   @default("OPEN") // OPEN | CLOSED
  source            String // anthropic | mock (a conversation never mixes the two)
  model             String?
  ticketId          String?  @db.Uuid // support ticket opened from this chat
  turns             Int      @default(0) // customer messages answered
  messageCount      Int      @default(0)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  lastMessageAt     DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  messages AssistantMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([subscriberId, status])
}

model AssistantMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @db.Uuid
  organizationId String   @db.Uuid
  seq            Int
  role           String // user | assistant (sent to the model) | notice (shown to the customer only)
  content        Json // Messages API content blocks as sent/received
  text           String? // visible text: what the customer typed, the assistant's reply, or the notice
  tools          String[] // tools called (assistant) or answered (user tool results)
  replay         Boolean  @default(true) // false: kept for the transcript but never sent to the model again (refused turn)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
}
